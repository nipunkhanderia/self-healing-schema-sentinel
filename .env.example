# Copy this to .env and fill in your values

# LLM backend: "groq" or "ollama"
LLM_BACKEND=groq

# Groq API key (get free key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama config (used when LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# GitHub integration (optional — needed for PR mode)
GITHUB_TOKEN=your_github_pat_here
GITHUB_REPO=owner/repo-name
GITHUB_BASE_BRANCH=main

# Output mode: "local" or "pr"
OUTPUT_MODE=local

# Directory for storing schema versions
SCHEMA_STORE_DIR=.sentinel/schemas

# Directory where generated test files are written
GENERATED_TESTS_DIR=generated_tests
