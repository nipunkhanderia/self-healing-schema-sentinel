{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AirlineBooking",
  "type": "object",
  "required": ["flight_number", "departure_airport", "arrival_airport", "passenger_name", "price"],
  "properties": {
    "flight_number": { "type": "string" },
    "departure_airport": { "type": "string" },
    "arrival_airport": { "type": "string" },
    "departure_time": { "type": "string", "format": "date-time" },
    "passenger_name": { "type": "string" },
    "seat_number": { "type": "string" },
    "price": { "type": "number", "description": "Price as float e.g. 249.99" },
    "currency": { "type": "string", "default": "GBP" },
    "baggage_allowance": { "type": "integer", "description": "Baggage allowance in kg" },
    "loyalty_number": { "type": "string", "description": "Frequent flyer number" }
  }
}
